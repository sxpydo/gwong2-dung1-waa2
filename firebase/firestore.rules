rules_version = '2';

// Cantonese Trip Prep — each signed-in user (anonymous or Google-linked) can
// only read/write their own review-state documents, stored at
// users/{uid}/reviews/{phraseId}. Linking an anonymous session to Google
// keeps the same uid, so this rule needs no changes for that flow.
// Phrase content itself lives in the app bundle (src/data), not Firestore.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/reviews/{phraseId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
